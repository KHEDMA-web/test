# ─────────────────────────────────────────────────────────────
# ClipFlow — configuration
# Sans clés, la plateforme tourne en MOCK : tout le flux est
# exécutable de bout en bout, aucun appel réseau sortant.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://clipflow:clipflow@127.0.0.1:5432/clipflow?schema=public"

# Force le mode mock même si des clés sont présentes (1/0)
CLIPFLOW_MOCK=0

# Dossier de stockage des rushes et clips rendus
CLIPFLOW_STORAGE_DIR="./storage"
# URL publique de base (Metricool exige des médias publics et non expirants)
CLIPFLOW_PUBLIC_BASE_URL="http://localhost:3000"

# ── Étage 1 : Whop (recrutement + accès clippers) ────────────
# Dashboard > Developer. API v1 : https://api.whop.com/api/v1
WHOP_API_KEY=""
WHOP_API_VERSION_DATE="2026-11-04-1"
WHOP_ENV="production"                 # production | sandbox
WHOP_WEBHOOK_SECRET=""                # ws_... (Standard Webhooks)
WHOP_COMPANY_ID=""                    # biz_...
WHOP_PRODUCT_ID=""                    # access pass des clippers (prod_...)
WHOP_OAUTH_CLIENT_ID=""               # app_...
WHOP_OAUTH_CLIENT_SECRET=""
WHOP_OAUTH_REDIRECT_URI="http://localhost:3000/api/whop/oauth/callback"

# ── Étage 2 : transcription ──────────────────────────────────
TRANSCRIPTION_PROVIDER="mock"         # mock | openai | deepgram | local-whisper
OPENAI_API_KEY=""
DEEPGRAM_API_KEY=""

# ── Étage 3 : génération de hooks (LLM optionnel) ────────────
HOOKS_PROVIDER="heuristic"            # heuristic | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# ── Étage 5 : Metricool (publication) ────────────────────────
# Settings > API. Le token part dans l'en-tête X-Mc-Auth,
# userId et blogId dans la query string.
METRICOOL_USER_TOKEN=""
METRICOOL_USER_ID=""
METRICOOL_BLOG_ID=""                  # marque par défaut
METRICOOL_TIMEZONE="Europe/Paris"
