# ─────────────────────────────────────────────────────────────
# ClipFlow — configuration
# Sans clés, la plateforme tourne en MOCK : tout le flux est
# exécutable de bout en bout, aucun appel réseau sortant.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://clipflow:clipflow@127.0.0.1:5432/clipflow?schema=public"

# Force le mode mock même si des clés sont présentes (1/0)
CLIPFLOW_MOCK=0

# Dossier de stockage des rushes et clips rendus
CLIPFLOW_STORAGE_DIR="./storage"
# URL publique de base (Metricool exige des médias publics et non expirants)
CLIPFLOW_PUBLIC_BASE_URL="http://localhost:3000"

# ── Étage 1 : Whop (recrutement + accès clippers) ────────────
# Dashboard > Developer. API v1 : https://api.whop.com/api/v1
WHOP_API_KEY=""
WHOP_API_VERSION_DATE="2026-11-04-1"
WHOP_ENV="production"                 # production | sandbox
WHOP_WEBHOOK_SECRET=""                # ws_... (Standard Webhooks)
WHOP_COMPANY_ID=""                    # biz_...
WHOP_PRODUCT_ID=""                    # access pass des clippers (prod_...)
WHOP_OAUTH_CLIENT_ID=""               # app_...
WHOP_OAUTH_CLIENT_SECRET=""
WHOP_OAUTH_REDIRECT_URI="http://localhost:3000/api/whop/oauth/callback"

# ── Étage 2 : transcription ──────────────────────────────────
# local-whisper = GRATUIT, tourne sur votre machine, aucune clé.
#   Installation : ./scripts/setup-local-transcription.sh
# openai / deepgram = payants à la minute, plus rapides.
# mock = faux transcript, pour essayer la plateforme sans rien installer.
TRANSCRIPTION_PROVIDER="local-whisper"
CLIPFLOW_WHISPER_MODEL="small"        # tiny | base | small | medium | large-v3
CLIPFLOW_WHISPER_DEVICE="auto"        # auto | cpu | cuda
CLIPFLOW_WHISPER_COMPUTE="int8"       # int8 sur processeur, float16 sur carte NVIDIA
OPENAI_API_KEY=""
DEEPGRAM_API_KEY=""

# ── Étage 3 : hooks candidats (facultatif) ───────────────────
# heuristic = GRATUIT. Le vrai travail éditorial passe de toute façon par
# Claude Desktop (abonnement), pas par des crédits API.
HOOKS_PROVIDER="heuristic"            # heuristic | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# ── Étage 5 : Metricool (publication) — PAYANT, facultatif ───
# L'API REST exige le plan Advanced. Pour rester à zéro euro, utilisez
# plutôt le MCP Metricool (disponible sur le plan Free) depuis Claude
# Desktop : https://ai.metricool.com/mcp
# Settings > API. Le token part dans l'en-tête X-Mc-Auth,
# userId et blogId dans la query string.
METRICOOL_USER_TOKEN=""
METRICOOL_USER_ID=""
METRICOOL_BLOG_ID=""                  # marque par défaut
METRICOOL_TIMEZONE="Europe/Paris"

# ── Livraison : le dossier synchronisé (Drive, Dropbox, iCloud…) ──
# Chemin LOCAL du dossier synchronisé sur cette machine. Dès qu'un clip
# y est écrit, le client de synchronisation l'envoie en ligne.
# macOS   : "/Users/moi/Google Drive/Mon Drive/Clips"
# Windows : "G:\\Mon Drive\\Clips"
# Linux   : "/home/moi/GoogleDrive/Clips"
CLIPFLOW_DELIVERY_DIR=""
# Livrer automatiquement dès qu'un clip est validé (1/0)
CLIPFLOW_AUTO_DELIVER=1
# Si ce dossier est aussi exposé en ligne, sa base d'URL (sert de média
# public pour Metricool).
CLIPFLOW_DELIVERY_PUBLIC_BASE=""

# ── API locale (serveur MCP) ──────────────────────────────────
# Jeton exigé sur les écritures. Laisser vide en local si la machine
# n'est pas exposée.
CLIPFLOW_API_TOKEN=""

# ── Ingestion par lien (yt-dlp) ──────────────────────────────
# YouTube peut exiger une vérification depuis certaines connexions
# (datacenter, VPN). Depuis une connexion domestique, ça passe en général
# sans rien. Sinon, exportez vos cookies dans un fichier et donnez son
# chemin ici. Twitch, Vimeo et la plupart des autres sites n'en ont pas
# besoin.
CLIPFLOW_YTDLP_COOKIES=""
